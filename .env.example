# Copy to .env.local for local dev (used by `vercel dev`).
# In production, set this in Vercel → Project Settings → Environment Variables.

# Neon Postgres pooled connection string.
# Get it from: Neon Console → your project → Connection Details → "Pooled connection"
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Resend API key (re_...). Required to send lead notification emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. MUST use a domain verified in Resend → Domains.
# The mailbox part (leads@) need not exist; any address on the verified domain works.
RESEND_FROM=Wallace Darling <leads@wallacedarling.com>

# Recipient(s) for lead notifications. Comma-separated for multiple.
# Recipients can be on any domain — only RESEND_FROM must match the verified one.
LEAD_NOTIFICATION_EMAIL=danielhenriquesnogueira@gmail.com,wally@darling-fg.com
